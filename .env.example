# ─────────────────────────────────────────────────────────────────────────────
# QR Profile — environment variables
#
# Local development: copy this file to ".env.local" and fill in the values.
# Vercel: add the same names under Project → Settings → Environment Variables.
# NEVER commit .env.local or paste these values anywhere public.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → Data API → "Project URL"
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → a "Secret key" (starts with sb_secret_)
# or the legacy "service_role" key. This key bypasses all database security, so it
# must only ever live on the server (it is never sent to browsers by this app).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# The permanent public address that is ENGRAVED into every tag, without a trailing
# slash. Use http://localhost:3000 for local testing only.
# Buy your real (short!) domain before exporting any batch for engraving:
# once a URL is engraved in steel it can never change.
PUBLIC_BASE_URL=http://localhost:3000

# Admin password for /admin. At least 12 characters; use a long passphrase.
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Random secret used to sign admin login cookies and anonymise IP addresses.
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs every admin out.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# ── Optional ────────────────────────────────────────────────────────────────

# Supabase Storage bucket for photos (created by supabase/schema.sql).
PHOTO_BUCKET=photos

# Max profile lookups per minute from one IP address. Mobile networks put many
# phones behind one IP, so do not set this too low.
RATE_LIMIT_LOOKUPS_PER_MINUTE=60

# "true" exports engraving URLs fully uppercase (HTTPS://DOMAIN/P/ABC2345).
# This makes the QR code smaller (fewer modules), which helps tiny 5 mm codes.
# Test with your phones on the admin QR test page before switching it on, and
# never change it after a batch has been engraved.
QR_URL_UPPERCASE=false

# Time zone used for dates in the admin area (IANA name, e.g. Europe/London).
DISPLAY_TIME_ZONE=UTC
